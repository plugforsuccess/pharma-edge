{
  "name": "cash-moves",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verdict:check:client": "node scripts/check-verdict-client.mjs",
    "verdict:check:server": "deno run --allow-read scripts/check-verdict-server.ts",
    "verdict:check": "npm run verdict:check:client && npm run verdict:check:server",
    "aftertax:check": "node scripts/check-after-tax.mjs",
    "charttools:check": "node scripts/check-chart-tools.mjs",
    "indicators:check": "node scripts/check-indicators.mjs && node scripts/sync-edge-indicators.mjs --check",
    "indicators:sync": "node scripts/sync-edge-indicators.mjs",
    "entryevents:check": "node scripts/check-entry-events.mjs",
    "suite:check": "node scripts/check-signal-suite.mjs",
    "ldp:risk:check": "node --experimental-strip-types --no-warnings scripts/check-ldp-risk-tier.ts",
    "peers:check": "node scripts/check-peers.mjs",
    "confluence:check": "node scripts/check-confluence.mjs",
    "rank:dry": "node scripts/rank-confluence.mjs --mode dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.10"
  }
}
